FROM mcr.microsoft.com/playwright:v1.63.0-noble@sha256:eff16c30e6f3f4af0a03fa4b706120d5e9b0891c344a27d64559aff5900a4a27
RUN set -eu; arch="$(uname -m)"; case "$arch" in aarch64) arch=arm64;; x86_64) arch=x64;; *) exit 1;; esac; \
    cd /tmp; archive="node-v24.21.0-linux-$arch.tar.gz"; \
    curl -fsSLO "https://nodejs.org/dist/v24.21.0/$archive"; \
    curl -fsSLo SHASUMS256.txt https://nodejs.org/dist/v24.21.0/SHASUMS256.txt; \
    grep " $archive$" SHASUMS256.txt | sha256sum -c -; \
    mkdir /opt/pinned-node; tar -xzf "$archive" -C /opt/pinned-node --strip-components=1; \
    rm "$archive" SHASUMS256.txt
ENV PATH="/opt/pinned-node/bin:$PATH"
RUN npm install --global pnpm@12.8.1
ENV CI=true STORYBOOK_DISABLE_TELEMETRY=1
WORKDIR /workspace
