{
  "name": "bench-design",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shared React design system \u2014 executable bootstrap, no components yet",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=24.21.0"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tokens.css": "./dist/tokens.css",
    "./styles.css": "./dist/styles.css",
    "./theme-init.js": "./dist/theme-init.js"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json && node scripts/build-foundations.ts",
    "test:package": "node scripts/check-package.ts",
    "storybook": "pnpm build && storybook dev --port 6006 --host 127.0.0.1 --no-open --disable-telemetry",
    "build-storybook": "pnpm build && storybook build --disable-telemetry",
    "check": "biome check . && tsc --noEmit && node scripts/check-boundaries.ts && node scripts/check-javascript.ts && node scripts/check-stories.ts",
    "test": "vitest run && node --test tests/tooling/*.test.ts",
    "test:browser": "playwright test",
    "verify": "node scripts/verify.ts",
    "check:visual-values": "node scripts/check-visual-values.ts"
  },
  "peerDependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "dependencies": {
    "react-aria-components": "1.21.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@babel/parser": "7.29.9",
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.63.0",
    "@storybook/addon-a11y": "10.6.1",
    "@storybook/react-vite": "10.6.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "30.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "storybook": "10.6.1",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "vitest": "5.0.3",
    "css-tree": "3.2.1"
  }
}
