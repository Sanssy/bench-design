{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "declarationMap": false,
    "outDir": "dist",
    "rootDir": "src",
    "types": []
  },
  "include": ["src"],
  "exclude": [
    "tests",
    ".storybook",
    "src/**/*.stories.tsx",
    "src/**/*.test.tsx",
    "src/**/*.browser.spec.ts"
  ]
}
